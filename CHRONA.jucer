<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="chrnA1" name="CHRONA" projectType="audioplug" jucerFormatVersion="1"
              useAppConfig="0" addUsingNamespaceToJuceHeader="0" displaySplashScreen="0"
              companyName="Anonymous" companyCopyright="" bundleIdentifier="audio.chrona.chrona"
              cppLanguageStandard="17" version="0.1.0"
              pluginName="CHRONA" pluginDesc="Temporal manipulation"
              pluginManufacturer="Anonymous" pluginManufacturerCode="Anon" pluginCode="Chrn"
              pluginFormats="buildVST3,buildAU,buildStandalone"
              pluginCharacteristicsValue="pluginWantsMidiIn"
              pluginVST3Category="Delay,Fx,Modulation"
              pluginAUMainType="'aufx'"
              defines="JUCE_VST3_CAN_REPLACE_VST2=0">
  <MAINGROUP id="rootGrp" name="CHRONA">
    <GROUP id="srcGrp" name="Source">
      <FILE id="src001" name="PluginProcessor.cpp" compile="1" resource="0" file="Source/PluginProcessor.cpp"/>
      <FILE id="src002" name="PluginProcessor.h"   compile="0" resource="0" file="Source/PluginProcessor.h"/>
      <FILE id="src003" name="PluginEditor.h"      compile="0" resource="0" file="Source/PluginEditor.h"/>
      <GROUP id="grpParams" name="params">
        <FILE id="par001" name="Parameters.cpp" compile="1" resource="0" file="Source/params/Parameters.cpp"/>
        <FILE id="par002" name="Parameters.h"   compile="0" resource="0" file="Source/params/Parameters.h"/>
      </GROUP>
      <GROUP id="grpDsp" name="dsp">
        <FILE id="dsp001" name="Interpolation.h"   compile="0" resource="0" file="Source/dsp/Interpolation.h"/>
        <FILE id="dsp002" name="CircularBuffer.h"  compile="0" resource="0" file="Source/dsp/CircularBuffer.h"/>
        <FILE id="dsp003" name="AntiClick.h"       compile="0" resource="0" file="Source/dsp/AntiClick.h"/>
        <FILE id="dsp004" name="DspUtils.h"        compile="0" resource="0" file="Source/dsp/DspUtils.h"/>
        <FILE id="dsp005" name="Space.h"           compile="0" resource="0" file="Source/dsp/Space.h"/>
        <FILE id="dsp006" name="Modes.h"           compile="0" resource="0" file="Source/dsp/Modes.h"/>
        <FILE id="dsp007" name="TemporalEngine.h"  compile="0" resource="0" file="Source/dsp/TemporalEngine.h"/>
        <FILE id="dsp008" name="TemporalEngine.cpp" compile="1" resource="0" file="Source/dsp/TemporalEngine.cpp"/>
      </GROUP>
      <GROUP id="grpAuto" name="automation">
        <FILE id="aut001" name="Curve.h"            compile="0" resource="0" file="Source/automation/Curve.h"/>
        <FILE id="aut002" name="AutomationEngine.h" compile="0" resource="0" file="Source/automation/AutomationEngine.h"/>
      </GROUP>
      <GROUP id="grpMidi" name="midi">
        <FILE id="mid001" name="MidiTriggerSystem.h" compile="0" resource="0" file="Source/midi/MidiTriggerSystem.h"/>
      </GROUP>
      <GROUP id="grpPreset" name="presets">
        <FILE id="pre001" name="PresetManager.h"   compile="0" resource="0" file="Source/presets/PresetManager.h"/>
        <FILE id="pre002" name="PresetManager.cpp" compile="1" resource="0" file="Source/presets/PresetManager.cpp"/>
      </GROUP>
      <GROUP id="grpUi" name="ui">
        <FILE id="ui001" name="Theme.h"             compile="0" resource="0" file="Source/ui/Theme.h"/>
        <FILE id="ui002" name="ChronaLookAndFeel.h" compile="0" resource="0" file="Source/ui/ChronaLookAndFeel.h"/>
        <FILE id="ui003" name="BigKnob.h"           compile="0" resource="0" file="Source/ui/BigKnob.h"/>
        <FILE id="ui004" name="ModeSelector.h"      compile="0" resource="0" file="Source/ui/ModeSelector.h"/>
        <FILE id="ui005" name="Level1Panel.h"       compile="0" resource="0" file="Source/ui/Level1Panel.h"/>
        <FILE id="ui006" name="Level2Panel.h"       compile="0" resource="0" file="Source/ui/Level2Panel.h"/>
      </GROUP>
      <GROUP id="grpVis" name="visualizer">
        <FILE id="vis001" name="WaveformDisplay.h" compile="0" resource="0" file="Source/visualizer/WaveformDisplay.h"/>
        <FILE id="vis002" name="CurveEditor.h"     compile="0" resource="0" file="Source/visualizer/CurveEditor.h"/>
      </GROUP>
    </GROUP>
  </MAINGROUP>
  <MODULES>
    <MODULE id="juce_audio_basics"        showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_devices"       showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_formats"       showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_plugin_client" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_processors"    showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_utils"         showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_core"                showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_data_structures"     showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_dsp"                 showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_events"              showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_graphics"            showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_gui_basics"          showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_gui_extra"           showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
  </MODULES>
  <JUCEOPTIONS JUCE_STRICT_REFCOUNTEDPOINTER="1"
               JUCE_WEB_BROWSER="0"
               JUCE_USE_CURL="0"
               JUCE_VST3_CAN_REPLACE_VST2="0"
               JUCE_REPORT_APP_USAGE="0"/>
  <EXPORTFORMATS>
    <XCODE_MAC targetFolder="Builds/MacOSX" microphonePermissionNeeded="1">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="1" name="Debug"   targetName="CHRONA"/>
        <CONFIGURATION isDebug="0" name="Release" targetName="CHRONA" optimisation="3"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics"        path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices"       path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats"       path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_plugin_client" path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors"    path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_utils"         path="../../JUCE/modules"/>
        <MODULEPATH id="juce_core"                path="../../JUCE/modules"/>
        <MODULEPATH id="juce_data_structures"     path="../../JUCE/modules"/>
        <MODULEPATH id="juce_dsp"                 path="../../JUCE/modules"/>
        <MODULEPATH id="juce_events"              path="../../JUCE/modules"/>
        <MODULEPATH id="juce_graphics"            path="../../JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics"          path="../../JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra"           path="../../JUCE/modules"/>
      </MODULEPATHS>
    </XCODE_MAC>
    <VS2022 targetFolder="Builds/VisualStudio2022">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="1" name="Debug"   targetName="CHRONA"/>
        <CONFIGURATION isDebug="0" name="Release" targetName="CHRONA" optimisation="3"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics"        path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices"       path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats"       path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_plugin_client" path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors"    path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_utils"         path="../../JUCE/modules"/>
        <MODULEPATH id="juce_core"                path="../../JUCE/modules"/>
        <MODULEPATH id="juce_data_structures"     path="../../JUCE/modules"/>
        <MODULEPATH id="juce_dsp"                 path="../../JUCE/modules"/>
        <MODULEPATH id="juce_events"              path="../../JUCE/modules"/>
        <MODULEPATH id="juce_graphics"            path="../../JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics"          path="../../JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra"           path="../../JUCE/modules"/>
      </MODULEPATHS>
    </VS2022>
    <LINUX_MAKE targetFolder="Builds/LinuxMakefile">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="1" name="Debug"   targetName="CHRONA"/>
        <CONFIGURATION isDebug="0" name="Release" targetName="CHRONA" optimisation="3"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics"        path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices"       path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats"       path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_plugin_client" path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors"    path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_utils"         path="../../JUCE/modules"/>
        <MODULEPATH id="juce_core"                path="../../JUCE/modules"/>
        <MODULEPATH id="juce_data_structures"     path="../../JUCE/modules"/>
        <MODULEPATH id="juce_dsp"                 path="../../JUCE/modules"/>
        <MODULEPATH id="juce_events"              path="../../JUCE/modules"/>
        <MODULEPATH id="juce_graphics"            path="../../JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics"          path="../../JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra"           path="../../JUCE/modules"/>
      </MODULEPATHS>
    </LINUX_MAKE>
  </EXPORTFORMATS>
</JUCERPROJECT>
